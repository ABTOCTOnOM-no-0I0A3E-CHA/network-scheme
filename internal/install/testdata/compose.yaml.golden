# Rendered by nmsctl install. Secrets come only from files in /etc/nms/secrets.
name: nms

services:
  postgres:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "timescale/timescaledb:2.30.2-pg17@sha256:b346edcdb51a1fd6020e3965e0bd1c9f3406fa6d5fbce1e28f4852587ef934e2"
    # No telemetry: the image would otherwise phone home (blocked anyway: core is internal).
    command: ["postgres", "-c", "timescaledb.telemetry_level=off"]
    restart: unless-stopped
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
    cpus: "2.0"
    mem_limit: 2g
    environment:
      POSTGRES_DB: "nms"
      POSTGRES_PASSWORD_FILE: /run/secrets/db_postgres_password
    secrets: [db_postgres_password, db_migrator_password, db_api_password, db_cli_password, db_poller_password]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - "/etc/nms/postgres/initdb:/docker-entrypoint-initdb.d:ro"
    networks:
      core: {}
    healthcheck:
      # TCP probe: the init-time server listens on the socket only, so this waits for the real start.
      test: ["CMD", "pg_isready", "-h", "127.0.0.1", "-U", "postgres", "-d", "nms"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 30s

  migrate:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "nms/api:1.0.0"
    command: ["migrate"]
    restart: "no"
    read_only: true
    user: "65532:65532"
    cpus: "0.5"
    mem_limit: 256m
    secrets: [db_migrator_password]
    volumes:
      - "/etc/nms/config/api.yaml:/etc/nms/api.yaml:ro"
    networks:
      core: {}
    depends_on:
      postgres:
        condition: service_healthy

  api:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "nms/api:1.0.0"
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 512m
    secrets: [db_api_password, api_data_key]
    volumes:
      - "/etc/nms/config/api.yaml:/etc/nms/api.yaml:ro"
    networks:
      core: {}
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "/api", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  poller:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "nms/api:1.0.0"
    entrypoint: ["/poller"]
    command: ["run"]
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 512m
    # Unprivileged ICMP echo (no CAP_NET_RAW) for every group of the container.
    sysctls:
      net.ipv4.ping_group_range: "0 2147483647"
    secrets: [db_poller_password, domain_read_key]
    volumes:
      - "/etc/nms/config/poller.yaml:/etc/nms/poller.yaml:ro"
      - "/etc/nms/config/domain_read.pub:/etc/nms/domain_read.pub:ro"
    networks:
      core: {}
      devices: {}
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "/poller", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  gateway:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "nms/gateway:1.0.0"
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 256m
    tmpfs: [/tmp]
    ports: ["443:8443"]
    secrets:
      - source: web_crt
        target: /certs/web.crt
      - source: web_key
        target: /certs/web.key
    volumes:
      - caddy-data:/data
      - "/etc/nms/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "/var/lib/nms/gateway/keys.json:/srv/keys/keys.json:ro"
    networks:
      edge: {}
      core:
        ipv4_address: "172.30.0.2"
    depends_on:
      api:
        condition: service_healthy

  nmsctl:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "nms/api:1.0.0"
    entrypoint: ["/nmsctl"]
    profiles: [tools]
    restart: "no"
    read_only: true
    user: "65532:65532"
    cpus: "0.5"
    mem_limit: 256m
    secrets: [db_cli_password, api_data_key]
    volumes:
      - "/etc/nms/config/api.yaml:/etc/nms/api.yaml:ro"
      - "/var/lib/nms/anchors:/var/lib/nms/anchors"
    networks:
      core: {}

networks:
  edge: {}
  core:
    internal: true
    ipam:
      config:
        - subnet: "172.30.0.0/24"
          ip_range: "172.30.0.128/25"
  # Towards the devices: routed, but DOCKER-USER lets it reach only the management subnets.
  devices:
    # IPv4 only: the egress rules are iptables (IPv4) rules.
    enable_ipv6: false
    ipam:
      config:
        - subnet: "172.30.1.0/24"

volumes:
  pgdata: {}
  caddy-data: {}

secrets:
  db_postgres_password:
    file: "/etc/nms/secrets/db_postgres_password"
  db_migrator_password:
    file: "/etc/nms/secrets/db_migrator_password"
  db_api_password:
    file: "/etc/nms/secrets/db_api_password"
  db_cli_password:
    file: "/etc/nms/secrets/db_cli_password"
  db_poller_password:
    file: "/etc/nms/secrets/db_poller_password"
  domain_read_key:
    file: "/etc/nms/secrets/domain_read.key"
  api_data_key:
    file: "/etc/nms/secrets/api_data_key"
  web_crt:
    file: "/etc/nms/secrets/web.crt"
  web_key:
    file: "/etc/nms/secrets/web.key"
