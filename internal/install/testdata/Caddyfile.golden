# Rendered by nmsctl install. Panel origin https://nms.example.org.
{
	admin off
	persist_config off
	auto_https disable_redirects
	ocsp_stapling off
	servers {
		protocols h1 h2
	}
}

# Panel headers: imported by the site and by handle_errors, so error responses carry them too.
# The argument only keeps the matcher names unique per import. Map background images (GET /api/map/backgrounds/<id>) get a sandboxing CSP of their own instead of the
# panel one, set here so that a compromised api cannot choose it.
(panel_headers) {
	@panel_csp_{args[0]} not path /api/map/backgrounds/*
	header @panel_csp_{args[0]} {
		Content-Security-Policy "default-src 'self'; script-src https://nms.example.org/assets/; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://nms.example.org:8443; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		defer
	}
	@image_csp_{args[0]} path /api/map/backgrounds/*
	header @image_csp_{args[0]} {
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; sandbox"
		defer
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		defer
	}
}

:8443 {
	tls /certs/web.crt /certs/web.key {
		protocols tls1.3
	}

	import panel_headers site

	# 1 MiB everywhere except the background upload (20 MiB image plus multipart framing, as in the api).
	@small_body not path /api/map/backgrounds
	request_body @small_body {
		max_size 1MiB
	}
	@upload path /api/map/backgrounds
	request_body @upload {
		max_size 21MiB
	}

	root * /srv/app

	@sw header Service-Worker *

	# route keeps the written order: the service-worker check runs before any handler.
	route {
		respond @sw 403

		handle /api/auth/* {
			reverse_proxy api:8080 {
				header_up X-Forwarded-For {remote_host}
				header_down -Service-Worker-Allowed
				header_down -Content-Security-Policy
				header_down Content-Type "application/json; charset=utf-8"
			}
		}

		# WebSocket feed: reverse_proxy upgrades the connection itself and keeps it open (no stream
		# timeout); no body headers are forced on the 101 response. Origin and cookies pass through.
		handle /api/ws {
			reverse_proxy api:8080 {
				header_up X-Forwarded-For {remote_host}
				header_down -Service-Worker-Allowed
				header_down -Content-Security-Policy
				header_down -Set-Cookie
			}
		}

		# Images are served with the api's own Content-Type (never forced to JSON) and the gateway's CSP.
		handle /api/map/backgrounds/* {
			reverse_proxy api:8080 {
				header_up X-Forwarded-For {remote_host}
				header_down -Service-Worker-Allowed
				header_down -Content-Security-Policy
				header_down -Set-Cookie
			}
		}

		handle /api/* {
			reverse_proxy api:8080 {
				header_up X-Forwarded-For {remote_host}
				header_down -Service-Worker-Allowed
				header_down -Content-Security-Policy
				header_down Content-Type "application/json; charset=utf-8"
				header_down -Set-Cookie
			}
		}

		# The two origins of this installation, for the executor UI (which origin may frame it, which origin is its own) and
		# for the panel (where to find the executor). Static text from the gateway, so the api cannot change it.
		handle /origins.json {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			respond `{"panel":"https://nms.example.org","executor":"https://nms.example.org:8443"}` 200
		}

		handle /keys.json {
			root * /srv/keys
			file_server
		}

		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			try_files {path} /index.html
			file_server
		}
	}

	# Errors raised by Caddy itself (404 from file_server, 502/504 from the proxy, 413 from
	# request_body) bypass the normal response path; give them the same headers and,
	# under /api/*, the forced JSON shape.
	handle_errors {
		import panel_headers errors
		@api path /api/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			respond `{"error":{"code":"gateway_error","message":"Ошибка шлюза панели"}}` {err.status_code}
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}

# Executor origin headers (https://nms.example.org:8443): imported by the site and by handle_errors. Only the
# panel may frame it, scripts only from its own /assets/; the executor sets the same CSP on /x answers. Set-Cookie
# and Service-Worker-Allowed never leave this origin, whoever sets them.
(executor_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src https://nms.example.org:8443/assets/; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors https://nms.example.org; frame-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Set-Cookie
		-Service-Worker-Allowed
		-Server
		defer
	}
}

# The executor origin (published as 8443): its bundle and keys.json from the gateway's own files,
# /x/* to the executor's static address in xnet over mutual TLS. Nothing of the api is served here.
:9443 {
	# Only the gateway's address in edge, where Docker publishes the port: nothing listens on 9443 in core or
	# xnet, so the api (core) cannot use the gateway's client certificate to reach the executor.
	bind 172.30.3.2

	tls /certs/web.crt /certs/web.key {
		protocols tls1.3
	}

	import executor_headers

	# Only requests for the executor origin's host (the port is the published one, not checked here).
	@foreign_host not host nms.example.org

	request_body {
		max_size 64KiB
	}

	root * /srv/executor

	@sw header Service-Worker *

	route {
		error @foreign_host 421
		respond @sw 403

		# Cookies are dropped (a cookie set on :443 is sent to :8443 too; the executor never reads one) and never
		# set. X-Forwarded-For is written here with the browser's address, replacing whatever the browser sent:
		# the executor takes the client address from it alone.
		handle /x/* {
			reverse_proxy https://172.30.2.2:8444 {
				header_up -Cookie
				# The browser's Host (checked above), not the upstream address: the executor checks it too.
				header_up Host {http.request.hostport}
				header_up X-Forwarded-For {remote_host}
				header_down -Set-Cookie
				header_down -Service-Worker-Allowed
				header_down -Content-Security-Policy
				header_down Content-Type "application/json; charset=utf-8"
				header_down Cache-Control "no-store"
				transport http {
					tls_client_auth /certs/gateway_client.crt /certs/gateway_client.key
					tls_trust_pool file /certs/ca.crt
					tls_server_name executor
					versions 1.1
				}
			}
		}

		handle /api/* {
			error 404
		}

		# The two origins of this installation, for the executor UI (which origin may frame it, which origin is its own) and
		# for the panel (where to find the executor). Static text from the gateway, so the api cannot change it.
		handle /origins.json {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			respond `{"panel":"https://nms.example.org","executor":"https://nms.example.org:8443"}` 200
		}

		handle /keys.json {
			root * /srv/keys
			file_server
		}

		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			file_server
		}
	}

	handle_errors {
		import executor_headers
		@x path /x/*
		handle @x {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			respond `{"error":{"code":"gateway_error"}}` {err.status_code}
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}
