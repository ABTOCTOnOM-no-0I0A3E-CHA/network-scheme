# Rendered by nmsctl install. Secrets come only from files in {{.Paths.Etc}}/secrets.
name: nms

services:
  postgres:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.DBImage}}"
    # No telemetry: the image would otherwise phone home (blocked anyway: core is internal).
    command: ["postgres", "-c", "timescaledb.telemetry_level=off"]
    restart: unless-stopped
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
    cpus: "2.0"
    mem_limit: 2g
    environment:
      POSTGRES_DB: "{{.DBName}}"
      POSTGRES_PASSWORD_FILE: /run/secrets/db_postgres_password
    secrets: [db_postgres_password, db_migrator_password, db_api_password, db_cli_password, db_poller_password, db_eventd_password, db_executor_password]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - "{{.Paths.Etc}}/postgres/initdb:/docker-entrypoint-initdb.d:ro"
    networks:
      core: {}
    healthcheck:
      # TCP probe: the init-time server listens on the socket only, so this waits for the real start.
      test: ["CMD", "pg_isready", "-h", "127.0.0.1", "-U", "postgres", "-d", "{{.DBName}}"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 30s

  migrate:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.APIImage}}:{{.ImageTag}}"
    command: ["migrate"]
    restart: "no"
    read_only: true
    user: "65532:65532"
    cpus: "0.5"
    mem_limit: 256m
    secrets: [db_migrator_password]
    volumes:
      - "{{.Paths.Etc}}/config/api.yaml:/etc/nms/api.yaml:ro"
    networks:
      core: {}
    depends_on:
      postgres:
        condition: service_healthy

  api:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.APIImage}}:{{.ImageTag}}"
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 512m
    environment:
      GOMEMLIMIT: 400MiB # soft heap limit below mem_limit: the collector works harder instead of the kernel killing the api
    # ticket_key signs the session tickets the executor verifies.
    secrets: [db_api_password, api_data_key, ticket_key]
    volumes:
      - "{{.Paths.Etc}}/config/api.yaml:/etc/nms/api.yaml:ro"
    networks:
      core: {}
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "/api", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  poller:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.APIImage}}:{{.ImageTag}}"
    entrypoint: ["/poller"]
    command: ["run"]
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 512m
    # Unprivileged ICMP echo (no CAP_NET_RAW) for every group of the container.
    sysctls:
      net.ipv4.ping_group_range: "0 2147483647"
    secrets: [db_poller_password, domain_read_key]
    volumes:
      - "{{.Paths.Etc}}/config/poller.yaml:/etc/nms/poller.yaml:ro"
      - "{{.Paths.Etc}}/config/domain_read.pub:/etc/nms/domain_read.pub:ro"
      - "{{.Paths.Etc}}/config/domain_backup.pub:/etc/nms/domain_backup.pub:ro"
    networks:
      core: {}
      devices: {}
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "/poller", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  eventd:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.APIImage}}:{{.ImageTag}}"
    entrypoint: ["/eventd"]
    command: ["run"]
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 512m
    # Soft heap target below mem_limit, so the collector works harder before the kernel OOM-kills.
    environment:
      GOMEMLIMIT: 400MiB
    # Unprivileged container ports, so no capability is needed; with the userland proxy off the
    # source address of every packet is the device's own (the identity of an event).
    # On devices (not only core) because core is internal: Docker publishes ports only through a
    # routed network. The published ports listen on every host interface; DOCKER-USER (nmsctl egress)
    # lets only the management subnets reach them. domain_read_key opens the read credentials
    # (community, SNMPv3 user) the sources are authenticated with.
    ports:
      - "514:1514/udp"
      - "514:1514/tcp"
      - "6514:6514/tcp"
      - "162:1162/udp"
    secrets: [db_eventd_password, domain_read_key, syslog_crt, syslog_key]
    volumes:
      - "{{.Paths.Etc}}/config/eventd.yaml:/etc/nms/eventd.yaml:ro"
      - "{{.Paths.Etc}}/config/domain_read.pub:/etc/nms/domain_read.pub:ro"
    networks:
      core: {}
      devices: {}
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "/eventd", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  # The only service that may change devices: its own image and user, the write, backup and sealing keys.
  # Listens only on its static address in xnet (gateway, mutual TLS); in core it is a database client only.
  executor:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.ExecutorImage}}:{{.ImageTag}}"
    restart: unless-stopped
    read_only: true
    user: "65533:65533"
    cpus: "1.0"
    mem_limit: 512m
    environment:
      GOMEMLIMIT: 400MiB
    # The administration socket (nmsctl executor, through docker compose exec) lives here.
    tmpfs: ["/run/executor:mode=0700,uid=65533,gid=65533"]
    secrets: [db_executor_password, executor_sealing_key, domain_write_key, domain_backup_key, ticket_pub, executor_tls_crt, executor_tls_key, ca_crt]
    volumes:
      - executor-state:/var/lib/executor
      - "{{.Paths.Etc}}/config/executor.yaml:/etc/nms/executor.yaml:ro"
      - "{{.Paths.Etc}}/config/egress.yaml:/etc/nms/egress.yaml:ro"
      - "{{.Paths.Etc}}/policies/executor.yaml:/etc/nms/policies/executor.yaml:ro"
    networks:
      core: {}
      devices: {}
      xnet:
        ipv4_address: "{{.ExecutorIP}}"
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "/executor", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  gateway:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.GatewayImage}}:{{.ImageTag}}"
    restart: unless-stopped
    read_only: true
    user: "65532:65532"
    cpus: "1.0"
    mem_limit: 256m
    tmpfs: [/tmp]
    # The panel, and the executor origin (a second site, proxied to the executor over xnet).
    ports: ["{{.HTTPSPort}}:8443", "{{.ExecutorPort}}:9443"]
    secrets:
      - source: web_crt
        target: /certs/web.crt
      - source: web_key
        target: /certs/web.key
      - source: gateway_client_crt
        target: /certs/gateway_client.crt
      - source: gateway_client_key
        target: /certs/gateway_client.key
      - source: ca_crt
        target: /certs/ca.crt
    volumes:
      - caddy-data:/data
      - "{{.Paths.Etc}}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "{{.Paths.Var}}/gateway/keys.json:/srv/keys/keys.json:ro"
    networks:
      edge: {}
      core:
        ipv4_address: "{{.GatewayIP}}"
      xnet: {}
    depends_on:
      api:
        condition: service_healthy

  nmsctl:
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    image: "{{.APIImage}}:{{.ImageTag}}"
    entrypoint: ["/nmsctl"]
    profiles: [tools]
    restart: "no"
    read_only: true
    user: "65532:65532"
    cpus: "0.5"
    mem_limit: 256m
    secrets: [db_cli_password, api_data_key]
    volumes:
      - "{{.Paths.Etc}}/config/api.yaml:/etc/nms/api.yaml:ro"
      - "{{.Paths.Var}}/anchors:/var/lib/nms/anchors"
    networks:
      core: {}

networks:
  edge: {}
  core:
    internal: true
    ipam:
      config:
        - subnet: "{{.CoreSubnet}}"
          ip_range: "{{.CoreIPRange}}"
  # Towards the devices: routed, but DOCKER-USER lets it reach only the management subnets.
  devices:
    # IPv4 only: the egress rules are iptables (IPv4) rules.
    enable_ipv6: false
    ipam:
      config:
        - subnet: "{{.DevicesSubnet}}"
  # Between the gateway and the executor only; no route out.
  xnet:
    internal: true
    ipam:
      config:
        - subnet: "{{.XnetSubnet}}"
          ip_range: "{{.XnetIPRange}}"

volumes:
  pgdata: {}
  caddy-data: {}
  # The executor's state file (registry high-water mark, audit anchor); no other service mounts it.
  executor-state: {}

secrets:
  db_postgres_password:
    file: "{{.Paths.Etc}}/secrets/db_postgres_password"
  db_migrator_password:
    file: "{{.Paths.Etc}}/secrets/db_migrator_password"
  db_api_password:
    file: "{{.Paths.Etc}}/secrets/db_api_password"
  db_cli_password:
    file: "{{.Paths.Etc}}/secrets/db_cli_password"
  db_poller_password:
    file: "{{.Paths.Etc}}/secrets/db_poller_password"
  db_eventd_password:
    file: "{{.Paths.Etc}}/secrets/db_eventd_password"
  db_executor_password:
    file: "{{.Paths.Etc}}/secrets/db_executor_password"
  domain_read_key:
    file: "{{.Paths.Etc}}/secrets/domain_read.key"
  domain_write_key:
    file: "{{.Paths.Etc}}/secrets/domain_write.key"
  domain_backup_key:
    file: "{{.Paths.Etc}}/secrets/domain_backup.key"
  executor_sealing_key:
    file: "{{.Paths.Etc}}/secrets/executor_sealing_key"
  ticket_key:
    file: "{{.Paths.Etc}}/secrets/ticket.key"
  ticket_pub:
    file: "{{.Paths.Etc}}/secrets/ticket.pub"
  executor_tls_crt:
    file: "{{.Paths.Etc}}/secrets/executor_tls.crt"
  executor_tls_key:
    file: "{{.Paths.Etc}}/secrets/executor_tls.key"
  gateway_client_crt:
    file: "{{.Paths.Etc}}/secrets/gateway_client.crt"
  gateway_client_key:
    file: "{{.Paths.Etc}}/secrets/gateway_client.key"
  ca_crt:
    file: "{{.Paths.Etc}}/secrets/ca.crt"
  syslog_crt:
    file: "{{.Paths.Etc}}/secrets/syslog.crt"
  syslog_key:
    file: "{{.Paths.Etc}}/secrets/syslog.key"
  api_data_key:
    file: "{{.Paths.Etc}}/secrets/api_data_key"
  web_crt:
    file: "{{.Paths.Etc}}/secrets/web.crt"
  web_key:
    file: "{{.Paths.Etc}}/secrets/web.key"
