# Rendered by nmsctl install. Secrets are referenced by docker-secret file paths only.
db:
  host: "postgres"
  port: 5432
  name: "{{.DBName}}"
  user: "nms_executor"
  password_file: "/run/secrets/db_executor_password"
sealing_key_file: "/run/secrets/executor_sealing_key"
write_key_file: "/run/secrets/domain_write_key"
backup_key_file: "/run/secrets/domain_backup_key"
ticket_pub_key_file: "/run/secrets/ticket_pub"
tls_cert_file: "/run/secrets/executor_tls_crt"
tls_key_file: "/run/secrets/executor_tls_key"
client_ca_file: "/run/secrets/ca_crt"
# Only the static address in xnet, never core; the gateway is the only client (mutual TLS).
listen_xnet: "{{.ExecutorIP}}:{{.ExecutorListenPort}}"
# The stack's own networks: no device address may fall into them (the devices subnet is in egress.yaml).
core_subnet: "{{.CoreSubnet}}"
xnet_subnet: "{{.XnetSubnet}}"
edge_subnet: "{{.EdgeSubnet}}"
panel_origin: "https://{{.Authority}}"
executor_origin: "https://{{.ExecutorAuthority}}"
state_dir: "/var/lib/executor"
policy_file: "/etc/nms/policies/executor.yaml"
egress_file: "/etc/nms/egress.yaml"
